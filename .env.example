# Where the integration tests look for the game files. Copy to .env at the
# repository root and edit; it is found from any folder below it.
#
# Only the `install` test tier reads these; see README.md. Within a
# tier, every one is required: an unset variable, or one pointing at a directory that
# is not a corpus, fails the tests that read it. There are no defaults. The
# process environment wins over this file.
#
# A value may be `~/...`, absolute, or relative to this file's folder. Quote
# it to keep a leading or trailing space.
#
# The layout below is the recommended one: the game files are copied into
# local/game/, which is git-ignored, so nothing moves under a running
# suite. Reading them out of a Steam library works, but Steam updates Workshop
# items without asking and will rewrite one mid-test-run.

# Windows Gold HD 1.5.2.28, GOG or Steam beta2: the build being
# reimplemented, and where the SDK lives.
MAJESTY_HD=local/game/hd

# Mods written against the SDK.
MAJESTY_WORKSHOP=local/game/workshop
